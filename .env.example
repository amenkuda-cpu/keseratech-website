# Kesera website. Copy to .env.local for development; set real values in production.

# Public address, used for canonical URLs, the sitemap and social images.
SITE_URL=https://keseratech.com

# Where the SQLite database lives (prices, projects, enquiries). Must be a persistent disk in production.
DATA_DIR=./data

# Admin (/admin). Both are required; without them the admin stays switched off.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: email each new enquiry to the team through Resend (https://resend.com).
# LEADS_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=info@keseratech.com
LEADS_FROM_EMAIL=Kesera website <website@keseratech.com>
